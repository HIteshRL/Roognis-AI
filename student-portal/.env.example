# Optional — the portal runs fully offline with extractive answers if this is unset.
# Set it to get live, natural-language answers from Groq (and the LLM concept-grounding judge).
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Optional — enables the Image Studio (right slide-out). Text-to-image runs via
# Hugging Face Inference (fal-ai provider). The studio shows a "not switched on"
# message until this is set.
HF_TOKEN=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_PROVIDER=fal-ai
