# Copy to .env and fill in.

# Groq — required for OCR (vision) and for LLM answers (query/ask/ocr).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
# Groq vision model IDs drift — verify at https://console.groq.com/docs/models
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Embeddings (local by default; no key needed)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OPENAI_API_KEY=sk-...            # only if EMBEDDING_PROVIDER=openai

# Vector store — run Qdrant: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_standalone
QDRANT_API_KEY=

# Chunking / retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
