# ─────────────────────────────────────────────────────────────────────────────
# Roognis AI — Environment Variables Template
# Copy this file to .env and fill in all values before running the application.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.2.0
# Set to 1 to seed a demo dataset (student/teacher/parent, a class with join
# code DEMO24, mastery/gaps/sessions) so dashboards render populated. Leave
# unset in production. Demo login password: Demo1234!
SEED_DEMO=0

# ── Backend ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-to-a-long-random-secret-key

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=roognis
POSTGRES_PASSWORD=roognis_password
POSTGRES_DB=roognis_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://roognis:roognis_password@localhost:5432/roognis_ai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Clerk Authentication ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_CHAT=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Phase 0.2: Vector Database (Qdrant) ──────────────────────────────────────
VECTOR_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=roognis_knowledge

# ── Phase 0.2: Embeddings ─────────────────────────────────────────────────────
# Options: fastembed (local, no key needed) | openai (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Phase 0.2: Chunking ───────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_STRATEGY=fixed

# ── Phase 0.2: Retrieval ──────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_ENABLED=true

# ── Phase 0.2: Storage ────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50
