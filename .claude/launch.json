{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "apps/web"
    },
    {
      "name": "FastAPI Backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "src.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "cwd": "apps/api"
    },
    {
      "name": "Docker Compose (full stack)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "port": 80,
      "cwd": "."
    },
    {
      "name": "Teacher UI Simulation",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4173"],
      "port": 4173,
      "cwd": ".preview/teacher-sim"
    },
    {
      "name": "Student UI Simulation",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4174"],
      "port": 4174,
      "cwd": ".preview/student-sim"
    },
    {
      "name": "Student Portal",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3.12", "-m", "uvicorn", "app:app", "--port", "5050"],
      "port": 5050,
      "cwd": "student-portal"
    }
  ]
}
