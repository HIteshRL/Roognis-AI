# ============================================================================
# Roognis AI — PRODUCTION env for the single-VM demo (docker-compose.prod.yml)
# Copy to `.env` on the server and fill in the <...> values.
#   cp .env.production.example .env  &&  nano .env
# ============================================================================

# ── Public address ──────────────────────────────────────────────────────────
# DOMAIN: the hostname the browser will use. Either a real domain pointed at
# this VM's IP (A record), or an IP-based name like 203-0-113-5.sslip.io
# (dashes = your IP). Caddy fetches a real HTTPS cert for it automatically.
DOMAIN=<your-domain-or-dashed-ip.sslip.io>
# PUBLIC_URL must be https://$DOMAIN — baked into the web build + used for CORS.
PUBLIC_URL=https://<your-domain-or-dashed-ip.sslip.io>

# ── Secrets / infra ─────────────────────────────────────────────────────────
APP_ENV=production
# 32+ random chars, e.g.  openssl rand -hex 32
API_SECRET_KEY=<32-plus-random-characters>
# Any strong password; the API + Postgres containers share it (compose wires URLs).
POSTGRES_PASSWORD=<strong-db-password>

# ── AI tutor (required) ─────────────────────────────────────────────────────
GROQ_API_KEY=<your-groq-key>          # console.groq.com

# ── Generative media (full-feature demo → Fal, no GPU needed) ───────────────
FAL_API_KEY=<your-fal-key>            # fal.ai  — powers BOTH images and video
IMAGE_GEN_PROVIDER=fal
VIDEO_GEN_PROVIDER=fal                # hosted LTX-Video; set to "stub" to disable

# ── Curriculum RAG (full-feature demo → on) ─────────────────────────────────
RETRIEVAL_ENABLED=true
SEED_CURRICULUM=1                     # ingest bundled Grade-8 Math chapters on boot

# ── Demo classroom seed ─────────────────────────────────────────────────────
SEED_DEMO=1                           # 5 students + teacher + parent + syllabus

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
