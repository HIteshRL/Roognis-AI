# ── Roognis MVP demo environment ─────────────────────────────────────────────
# Copy is created automatically by deploy.sh as deploy/oci/.env (gitignored).
#
# Live LLM tutoring (OPTIONAL). Get a free key at https://console.groq.com
# Leave BLANK to run fully offline — answers are extracted straight from the
# chapter text (no external calls, no key needed). Fill it in and restart to
# switch to live Llama 3.3 70B answers:  sudo systemctl restart roognis-portal
GROQ_API_KEY=

# Optional model override (defaults to llama-3.3-70b-versatile)
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
