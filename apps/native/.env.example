# Base URL of the Roognis FastAPI backend.
# Expo inlines any EXPO_PUBLIC_* var at build time.
#
# Android emulator  -> http://10.0.2.2:8000  (10.0.2.2 = host machine's localhost)
# Physical device   -> http://<your-LAN-ip>:8000  (e.g. http://192.168.1.20:8000)
# Deployed backend  -> https://api.roognis.ai
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
