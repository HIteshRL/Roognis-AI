# ── Core (required) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roognis
REDIS_URL=redis://localhost:6379
API_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
GROQ_API_KEY=

# ── Auth (Clerk frontend sync — optional for local dev) ─────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── Vector / embeddings ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_PROVIDER=fastembed

# ── File storage ─────────────────────────────────────────────────────────────
# "local" writes under STORAGE_LOCAL_PATH. "s3" covers any S3-compatible
# endpoint — AWS S3, Cloudflare R2, MinIO — via S3_ENDPOINT_URL.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (password reset / verification / invitations) ─────────────────────
# "console" logs outbound mail (dev default); "smtp" sends for real.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=no-reply@roognis.ai
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:3000
