# ── Copy to .env.local and fill in ──────────────────────────────────────────
# The app is fully gated by Clerk (see middleware.ts); it will not render
# without valid Clerk keys. Get them from https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Where Clerk sends users for auth (routes already exist in the app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Base URL of the Roognis backend API (FastAPI). All data + chat streaming
# comes from here. Point this at the running backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
